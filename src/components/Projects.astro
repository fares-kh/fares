---
import '../fonts.css';
---

<style>
    .projects-grid-container {
        display: grid;
        margin-top: 24px;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 1fr 1fr;
        justify-items: center;
        row-gap: 12px;
    }

    .project-grid-item {
        text-align: center;
    }

    .img-container {
        width: 520px;
        height: 300px;
        margin: 10px;
        overflow: hidden;
        img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            display: block;
            margin: auto;
        }
    }

    .img-container img.coca-cola {
        transform: translate(11%, -14%) scale(2);
    }

    .img-container.dartford {
        width: 520px;
        height: 400px;
        img {
            transform: scale(1.3);
        }
    }
</style>

<div class="projects-grid-container">
    <div class="project-grid-item">
        <div class="img-container">
            <img src="/public/assets/coca-cola.png" class="coca-cola" alt="coca-cola"/>
        </div>
        <span style="color: white;">Diet Coca-Cola Personalisation</span>
    </div>
    <div class="project-grid-item">
        <div class="img-container dartford">
            <img src="/public/assets/dartfordfc.png" alt="dartford"/>
        </div>
        <span style="color: white;">Dartford FC</span>
    </div>
    <div class="project-grid-item">
        <div class="img"></div>
        <span style="color: white;">Placeholder</span>
    </div>
    <div class="project-grid-item">
        <div class="img"></div>
        <span style="color: white;">Placeholder</span>
    </div>
    <div class="project-grid-item">
        <div class="img"></div>
        <span style="color: white;">Placeholder</span>
    </div>
    <div class="project-grid-item">
        <div class="img"></div>
        <span style="color: white;">Placeholder</span>
    </div>
</div>